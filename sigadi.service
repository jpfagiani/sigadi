[Unit]
Description=SIGADI - Sistema Interno de Gestao Administrativa Integrada
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sigadi
Group=sigadi
WorkingDirectory=/opt/sigadi
ExecStart=/usr/bin/python3 /opt/sigadi/run_sigadi.py @PORT@
Restart=always
RestartSec=3
# Permite abrir a porta 80 sem rodar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/sigadi

[Install]
WantedBy=multi-user.target
